model Recipe {
  id                  String   @id @default(cuid())
  title               String
  imageUrl            String?  @map("image_url")
  externalFoodId      String?  @unique @map("external_food_id") 
  
  summary             String?  @db.Text
  readyInMinutes      Int?     @map("ready_in_minutes")
  servings            Int?
  sourceName          String?  @map("source_name")
  sourceUrl           String?  @map("source_url")
  
  dishTypes           String[] @map("dish_types") 
  diets               String[]
  
  extendedIngredients Json     @map("extended_ingredients") 
  nutrition           Json?    
  analyzedInstructions Json   @map("analyzed_instructions") 
  
  healthScore         Float?   @map("health_score")
  pricePerServing     Float?   @map("price_per_serving")

  userId              String?  @map("user_id")
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  favorites           FavoriteRecipes[]

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([externalFoodId])
  @@map("recipes")
}