model Product {
  id               String   @id @default(cuid())
  name             String
  brand            String?
  externalFoodId   String?  @unique @map("external_food_id")
  calories         Float
  totalWeight      Float    @map("total_weight")
  
  dietLabels       Json?    @map("diet_labels")
  healthLabels     Json?    @map("health_labels")
  cautions         Json?
  
  totalNutrients   Json     @map("total_nutrients")
  totalDaily       Json?    @map("total_daily")
  ingredients      Json?

  userId           String?  @map("user_id")
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  favorites        FavoriteProduct[]

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([externalFoodId])
  @@map("products")
}